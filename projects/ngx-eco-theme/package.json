{
  "name": "@WeDoSoftware-eu/ngx-eco-theme",
  "description": "Shared library for UI components",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WeDoSoftware-eu/biodiverzitet-ui-component.git"
  },
  "version": "0.0.11",
  "scripts": {
    "ng": "ng",
    "build": "ng build",
    "pack": "mkdirp ../../bin && npm pack --pack-destination ../../bin",
    "link": "cd ../../dist/ngx-eco-theme && npm link",
    "publish-locally": "npm publish",
    "test": "ng test ngx-eco-theme --watch=false",
    "test:ci": "ng test ngx-eco-theme --watch=false --browsers=ChromeHeadless --code-coverage && npm run generate-coverage-badge",
    "generate-coverage-badge": "coverage-badges --output ../../coverage/ngx-eco-theme/coverage-badge.svg --source ../../coverage/ngx-eco-theme/coverage-final.json --label \"ngx-eco-theme coverage\"",
    "version-patch": "npm version patch"
  },
  "peerDependencies": {
    "@angular/common": "^18.2.14",
    "@angular/core": "^18.2.14",
    "@angular/material": "^18.2.14",
    "@angular/cdk": "^18.2.14",
    "@angular/animations": "^18.2.14",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "sideEffects": false
}
